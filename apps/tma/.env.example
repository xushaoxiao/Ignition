# API base URL. Leave empty in production when reverse-proxied on the same origin.
VITE_API_BASE=http://localhost:18080

# ---- Local debug only: Vite signs fresh initData ----
# No VITE_ prefix = Node-side only in vite.config; never bundled for the browser.
# Must match the Bot token sealed into bot.token_enc in the database.
DEV_BOT_TOKEN=123456:AA-demo-bot-token
